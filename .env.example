# Genera una cadena larga y aleatoria (por ejemplo: openssl rand -hex 32)
# y ponla aquí. Si la dejas vacía, el servidor genera una temporal en cada
# arranque y todas las sesiones se cerrarán cada vez que reinicie.
SESSION_SECRET=
